# Copy these settings to the backend GPU host environment.
# Do not put real secrets in this file or commit actual credentials.

COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=
COMFYUI_TIMEOUT_SECONDS=1800

# Optional overrides. FreeVerse includes default API workflows under backend/workflows/.
# Set these only if you maintain custom ComfyUI workflows.
# ROSCOE_IMAGE_WORKFLOW_JSON=/opt/comfyui/workflows/custom_neta_lumina_api.json
# ROSCOE_VIDEO_WORKFLOW_JSON=/opt/comfyui/workflows/custom_wan22_i2v_api.json

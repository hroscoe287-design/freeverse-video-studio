# Copy these settings to the backend GPU host environment.
# Do not put real secrets in this file or commit actual credentials.

COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=
COMFYUI_TIMEOUT_SECONDS=1800

# ComfyUI API-format workflow for Neta Lumina v1.0.
ROSCOE_IMAGE_WORKFLOW_JSON=/opt/comfyui/workflows/roscoe_neta_lumina_api.json

# ComfyUI API-format workflow for Wan 2.2 TI2V-5B.
ROSCOE_VIDEO_WORKFLOW_JSON=/opt/comfyui/workflows/roscoe_wan22_i2v_api.json
